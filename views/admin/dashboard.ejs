<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Dashboard Admin - Transportadora Aurora</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex h-screen bg-gray-100">

  <!-- Sidebar -->
  <aside class="w-64 bg-white p-6 shadow-md">
    <h2 class="text-2xl font-bold mb-8">Admin</h2>
    <nav class="flex flex-col gap-4">
      <a href="/admin/dashboard" class="text-blue-600">Pedidos</a>
      <a href="/admin/logout" class="text-red-600">Sair</a>
    </nav>
  </aside>

  <!-- Main -->
  <main class="flex-1 p-8 overflow-y-auto">
    <h1 class="text-3xl font-bold mb-6">Pedidos Recentes</h1>

    <div class="overflow-x-auto">
      <table class="w-full bg-white shadow-md rounded">
        <thead class="bg-gray-200">
          <tr>
            <th class="p-3 text-left">Nome</th>
            <th class="p-3 text-left">Código</th>
            <th class="p-3 text-left">Status</th>
            <th class="p-3 text-left">Ação</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function(order) { %>
            <tr class="border-t hover:bg-gray-50">
              <td class="p-3"><%= order.client_name %></td>
              <td class="p-3"><%= order.tracking_code %></td>
              <td class="p-3"><%= order.status %></td>
              <td class="p-3">
                <a href="/admin/pedido/<%= order.id %>" class="text-white bg-blue-600 px-4 py-2 rounded hover:bg-blue-700 font-medium">
                  Ver Detalhes
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
