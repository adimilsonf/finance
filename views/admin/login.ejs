<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Admin Login - Transportadora Aurora</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex items-center justify-center h-screen bg-gray-100">

    <form action="/admin/login" method="POST" class="bg-white p-8 rounded shadow-md w-80">
        <h1 class="text-2xl font-bold mb-6 text-center">Login Admin</h1>

        <% if (error) { %>
            <p class="text-red-500 text-center mb-4"><%= error %></p>
        <% } %>

        <div class="mb-4">
            <label class="block mb-2">Usuário</label>
            <input type="text" name="username" class="border p-2 w-full" required>
        </div>

        <div class="mb-6">
            <label class="block mb-2">Senha</label>
            <input type="password" name="password" class="border p-2 w-full" required>
        </div>

        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 w-full">
            Entrar
        </button>
    </form>

</body>
</html>
